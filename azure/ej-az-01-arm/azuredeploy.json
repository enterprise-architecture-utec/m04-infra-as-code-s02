{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "lab",
      "allowedValues": ["lab", "dev", "prod"],
      "metadata": {
        "description": "Nombre del entorno (lab, dev o prod)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Región donde se desplegarán los recursos"
      }
    },
    "storageAccountSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": ["Standard_LRS", "Standard_GRS", "Standard_ZRS"],
      "metadata": {
        "description": "SKU de la Storage Account"
      }
    },
    "uniqueSuffix": {
      "type": "string",
      "metadata": {
        "description": "Sufijo único para evitar conflictos de nombres (ej. nombre-del-alumno)"
      }
    },
    "functionRuntime": {
      "type": "string",
      "defaultValue": "node",
      "allowedValues": ["node", "dotnet", "python"],
      "metadata": {
        "description": "Runtime de Azure Functions"
      }
    }
  },

  "variables": {
    "storageAccountName": "[toLower(concat('st', parameters('uniqueSuffix'), uniqueString(resourceGroup().id)))]",
    "functionAppName": "[concat('func-', parameters('uniqueSuffix'), '-', parameters('environmentName'))]",
    "appServicePlanName": "[concat('plan-', parameters('uniqueSuffix'), '-', parameters('environmentName'))]"
  },

  "resources": [

    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentName')]",
        "Proyecto": "NativeIaC"
      },
      "sku": {
        "name": "[parameters('storageAccountSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "accessTier": "Hot"
      }
    },

    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[variables('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "name": "[variables('appServicePlanName')]"
      }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "kind": "functionapp",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]",
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2021-09-01').keys[0].value)]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "[parameters('functionRuntime')]"
            }
          ]
        }
      }
    }

  ],

  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "functionAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
    }
  }
}
