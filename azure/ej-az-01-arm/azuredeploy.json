{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "lab",
      "allowedValues": ["lab", "dev", "prod"],
      "metadata": {
        "description": "Nombre del entorno (lab, dev o prod)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "metadata": {
        "description": "Región donde se desplegarán los recursos (cambiar si hay problemas de cuota)"
      }
    },
    "storageAccountSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": ["Standard_LRS", "Standard_GRS", "Standard_ZRS"],
      "metadata": {
        "description": "SKU de la Storage Account"
      }
    },
    "uniqueSuffix": {
      "type": "string",
      "metadata": {
        "description": "Sufijo único para evitar conflictos de nombres (ej. nombre-del-alumno)"
      }
    }
  },

  "variables": {
    "storageAccountName": "[toLower(concat('st', parameters('uniqueSuffix'), uniqueString(resourceGroup().id)))]",
    "keyVaultName": "[concat('kv-', parameters('uniqueSuffix'), '-', parameters('environmentName'))]"
  },

  "resources": [

    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentName')]",
        "Proyecto": "NativeIaC"
      },
      "sku": {
        "name": "[parameters('storageAccountSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "accessTier": "Hot"
      }
    },

    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentName')]",
        "Proyecto": "NativeIaC"
      },
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "accessPolicies": [],
        "enabledForDeployment": false,
        "enabledForTemplateDeployment": false,
        "enabledForDiskEncryption": false,
        "enableRbacAuthorization": true,
        "softDeleteRetentionInDays": 7,
        "enableSoftDelete": true
      }
    }

  ],

  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "keyVaultId": {
      "type": "string",
      "value": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
    }
  }
}
